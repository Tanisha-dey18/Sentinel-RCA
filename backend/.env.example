# --- Storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/sentinel.db
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# Empty -> in-process cache fallback
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
# Empty QDRANT_URL -> embedded Qdrant stored at QDRANT_PATH (":memory:" for ephemeral)
QDRANT_URL=
QDRANT_PATH=./data/qdrant

# --- Embeddings: auto | hash | sentence-transformers ---------------------
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Optional LLM (Groq). Without a key, narratives are deterministic. ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AUTO_LLM_NARRATIVE=false

# --- Detection defaults ---------------------------------------------------
WINDOW_SECONDS=60
Z_THRESHOLD=3.5
MIN_ANOMALY_COUNT=3
CORRELATION_GAP_SECONDS=300
ANALYSIS_LOOKBACK_HOURS=24

# Seed a synthetic 'mixed' dataset on first start when the DB is empty
SEED_SAMPLE_DATA=true
